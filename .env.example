# Copy to .env.local and fill in. See docs/DEPLOYMENT.md §2 for details.
# Never commit .env.local. Never prefix a secret with NEXT_PUBLIC_.

# --- Site ---
NEXT_PUBLIC_SITE_URL=                 # https://<domain> (previews use VERCEL_URL)

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # safe to expose; RLS protects data
SUPABASE_SERVICE_ROLE_KEY=            # server only — NEVER NEXT_PUBLIC_

# --- Email (Resend) ---
RESEND_API_KEY=
CONTACT_FROM_EMAIL=                   # hello@<domain> once verified

# --- Rate limiting (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Bot protection (Cloudflare Turnstile) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Secrets ---
IP_HASH_SALT=                         # random 32 bytes
ADMIN_BACKUP_DOOR_TOKEN=              # random 32 chars, rotate yearly

# --- Errors (Sentry) ---
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Dev-only tooling (Agentation) — LOCAL ONLY, never set on Vercel ---
# NEXT_PUBLIC_AGENTATION_ENDPOINT=http://localhost:4747
